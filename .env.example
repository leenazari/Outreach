# Server-only. Create one at https://console.apify.com/settings/integrations
# Never prefix this with NEXT_PUBLIC_. Leave it empty to use sample data.
APIFY_TOKEN=

# Optional. When set, spoken job specs are read by gpt-4o-mini.
# When empty, the built-in rule parser is used. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Identity is returned when the match score is at or above this integer. Default 80.
UNLOCK_THRESHOLD=80

# Optional. When INTERVIEWA_WEBHOOK_URL is unset, no webhook is sent.
# The POST body is the unlocked-candidate export. The secret is sent as X-Interviewa-Webhook-Secret.
INTERVIEWA_WEBHOOK_URL=
INTERVIEWA_WEBHOOK_SECRET=
